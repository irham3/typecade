{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typecade",
  "account_id": "7ae7eb833dd0c9cee3dc23d735fa9601",
  "main": "apps/web/src/server/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],
  "observability": {
    "enabled": true
  }
}
