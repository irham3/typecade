# Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Analytics (Plausible)
# Leave NEXT_PUBLIC_PLAUSIBLE_DOMAIN unset to default to "typecade.com".
# Set NEXT_PUBLIC_PLAUSIBLE_API_HOST if you self-host Plausible.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=typecade.com
# NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.your-domain.com

# Search engine verification (optional)
# These are read by app/layout.tsx and emitted as <meta name="..."> tags.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Newsletter (Buttondown or any other hosted form provider)
# Paste your public form endpoint here. The NewsletterSignup component
# POSTs to it directly from the browser — no server needed (works with
# static export).
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://buttondown.email/yourusername