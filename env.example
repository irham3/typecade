# Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Newsletter (Buttondown or any other hosted form provider)
# Paste your public form endpoint here. The NewsletterSignup component
# POSTs to it directly from the browser — no server needed (works with
# static export).
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://buttondown.email/yourusername