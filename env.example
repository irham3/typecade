# Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Analytics (Plausible)
# Leave NEXT_PUBLIC_PLAUSIBLE_DOMAIN unset to default to "typecade.com".
# Set NEXT_PUBLIC_PLAUSIBLE_API_HOST if you self-host Plausible.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=typecade.com
# NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.your-domain.com

# Search engine verification (optional)
# These are read by app/layout.tsx and emitted as <meta name="..."> tags.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=