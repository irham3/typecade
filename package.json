{
  "name": "typecade",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:worker": "npm run build",
    "preview": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:rooms": "wrangler dev --port 8787",
    "deploy": "npm run build:worker && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "lint": "eslint",
    "typecheck:rooms": "tsc --project tsconfig.server.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "profile:dungeon": "node e2e/profile-dungeon.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
