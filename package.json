{
  "name": "typecade",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:worker": "npm run build",
    "preview": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:rooms": "wrangler dev --config wrangler.ocean.jsonc --port 8787",
    "deploy:ocean": "npm run build && wrangler deploy --config wrangler.ocean.jsonc",
    "deploy": "npm run build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "lint": "eslint",
    "typecheck:rooms": "tsc --project tsconfig.server.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.49.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.575.0",
    "next": "^16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@emnapi/runtime": "^1.11.3",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
